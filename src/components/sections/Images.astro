<script>
  const urlParams = new URLSearchParams(window.location.search);
  const seccion = urlParams.get('seccion');
  
  if (seccion === 'SQL') {
    document.getElementById('sql-screen')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  } 
  else if (seccion === 'Modelado') {
    document.getElementById('modelado-screen')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  } 
  else if (seccion === 'Normalizacion' || seccion === 'Normalización') {
    document.getElementById('normalizacion-screen')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  } 
  else if (seccion === 'Proyecto') {
    document.getElementById('proyecto-screen')?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  // Opcional: cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.fixed.inset-0').forEach(screen => {
        screen.classList.add('hidden');
      });
      document.body.style.overflow = 'visible';
    }
  });
</script>